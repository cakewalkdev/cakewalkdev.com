---
import Em from './Em.astro'

// Every screenshot is a 1200x975 browser view (the shape mattwaler.com's project shots use), shown
// whole. Repeaters is the 1x original from mattwaler.com; the others are 2x shots of the same view.
// The dimensions let the browser reserve space before each image arrives.
const projects = [
  {
    image: { src: '/images/cicolator.webp', width: 2400, height: 1950 },
    title: 'Cicolator',
    link: 'https://www.featherhour.com/cicolator/',
    text: 'A landing page AND iOS app for tracking daily calorie intake.',
  },
  {
    image: { src: '/images/trendyminds.webp', width: 2400, height: 1950 },
    title: 'TrendyMinds',
    link: 'https://trendyminds.com',
    text: 'The website for an Indiana-based digital marketing agency.',
  },
  {
    image: { src: '/images/repeaters.webp', width: 1200, height: 975 },
    title: 'Repeaters',
    link: 'https://mattwaler.com/repeaters',
    text: 'A landing page AND iOS app for tracking recurring tasks.',
  },
]
---

<section class="bg-linear-to-b from-black-navy to-navy spacer-py">
  <div class="container">
    <div class="text-balance text-white text-center">
      <h2 class="h1">What has Cakewalk built?</h2>
      <p class="h4 mt-5">
        Take a look at our <Em>latest</Em> and <Em>greatest</Em>.
      </p>
    </div>

    <!-- Cards in a row stretch to one height -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 md:mt-16">
      {projects.map((project, index) => (
        <a
          href={project.link}
          target="_blank"
          class:list={[
            // No border or white backing behind the image, so nothing light rims its edges; the
            // white lives on the text panel, which grows to fill the card to its full height
            'flex flex-col text-navy shadow-xl shadow-black/30 text-left',
            'max-w-xl mx-auto rounded-lg overflow-hidden',
            index % 2 === 1 ? 'tilt-left' : 'tilt-right',
          ]}
        >
          <img
            src={project.image.src}
            width={project.image.width}
            height={project.image.height}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          >
          <div class="flex-1 bg-white p-8">
            <h3 class="h4">{project.title}</h3>
            <p class="mt-1 md:text-lg text-pretty text-gray-500">{project.text}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
